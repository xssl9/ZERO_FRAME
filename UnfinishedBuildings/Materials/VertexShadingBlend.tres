[resource]
code = "shader_type spatial;
render_mode cull_disabled, specular_schlick_ggx;

uniform vec4 GrungeColor : hint_color;
uniform sampler2D ColorMap : hint_albedo;
uniform sampler2D RGBGrunges;
uniform sampler2D AlphaMap : hint_albedo;
uniform sampler2D AoRM;
uniform float Metallic__Strength;
uniform float Roughness__Strength;
uniform float AO_Strength;
uniform sampler2D Normal : hint_normal;
uniform float Normal_Strength;
uniform float AO_LightAffect;



void vertex() {
// Output:0

}

void fragment() {
// ColorUniform:57
	vec3 n_out57p0 = GrungeColor.rgb;
	float n_out57p1 = GrungeColor.a;

// TextureUniform:56
	vec3 n_out56p0;
	float n_out56p1;
	{
		vec4 n_tex_read = texture(ColorMap, UV.xy);
		n_out56p0 = n_tex_read.rgb;
		n_out56p1 = n_tex_read.a;
	}

// TextureUniform:58
	vec3 n_out58p0;
	float n_out58p1;
	{
		vec4 n_tex_read = texture(RGBGrunges, UV.xy);
		n_out58p0 = n_tex_read.rgb;
		n_out58p1 = n_tex_read.a;
	}

// VectorDecompose:59
	float n_out59p0 = n_out58p0.x;
	float n_out59p1 = n_out58p0.y;
	float n_out59p2 = n_out58p0.z;

// Input:2
	vec3 n_out2p0 = COLOR.rgb;

// VectorDecompose:3
	float n_out3p0 = n_out2p0.x;
	float n_out3p1 = n_out2p0.y;
	float n_out3p2 = n_out2p0.z;

// VectorMix:4
	vec3 n_in4p0 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_out4p0 = mix(n_in4p0, vec3(n_out59p0), vec3(n_out3p0));

// VectorMix:9
	vec3 n_out9p0 = mix(n_out4p0, vec3(n_out59p1), vec3(n_out3p1));

// VectorMix:10
	vec3 n_out10p0 = mix(n_out9p0, vec3(n_out59p1), vec3(n_out3p2));

// ScalarOp:29
	float n_out29p0 = n_out3p0 * n_out3p1;

// VectorMix:30
	vec3 n_in30p1 = vec3(1.00000, 1.00000, 1.00000);
	vec3 n_out30p0 = mix(n_out10p0, n_in30p1, vec3(n_out29p0));

// VectorMix:55
	vec3 n_out55p0 = mix(n_out57p0, n_out56p0, n_out30p0);

// TextureUniform:60
	vec3 n_out60p0;
	float n_out60p1;
	{
		vec4 n_tex_read = texture(AlphaMap, UV.xy);
		n_out60p0 = n_tex_read.rgb;
		n_out60p1 = n_tex_read.a;
	}

// TextureUniform:40
	vec3 n_out40p0;
	float n_out40p1;
	{
		vec4 n_tex_read = texture(AoRM, UV.xy);
		n_out40p0 = n_tex_read.rgb;
		n_out40p1 = n_tex_read.a;
	}

// VectorDecompose:18
	float n_out18p0 = n_out40p0.x;
	float n_out18p1 = n_out40p0.y;
	float n_out18p2 = n_out40p0.z;

// ScalarUniform:50
	float n_out50p0 = Metallic__Strength;

// ScalarOp:21
	float n_out21p0 = n_out18p2 * n_out50p0;

// ScalarUniform:51
	float n_out51p0 = Roughness__Strength;

// ScalarOp:20
	float n_out20p0 = n_out18p1 * n_out51p0;

// ScalarUniform:52
	float n_out52p0 = AO_Strength;

// ScalarOp:19
	float n_out19p0 = n_out18p0 * n_out52p0;

// TextureUniform:45
	vec3 n_out45p0;
	float n_out45p1;
	{
		vec4 n_tex_read = texture(Normal, UV.xy);
		n_out45p0 = n_tex_read.rgb;
		n_out45p1 = n_tex_read.a;
	}

// VectorDecompose:25
	float n_out25p0 = n_out45p0.x;
	float n_out25p1 = n_out45p0.y;
	float n_out25p2 = n_out45p0.z;

// VectorCompose:26
	float n_in26p2 = 0.00000;
	vec3 n_out26p0 = vec3(n_out25p0, n_out25p1, n_in26p2);

// ScalarUniform:54
	float n_out54p0 = Normal_Strength;

// VectorOp:27
	vec3 n_out27p0 = vec3(n_out25p0) * vec3(n_out54p0);

// ScalarUniform:53
	float n_out53p0 = AO_LightAffect;

// Output:0
	ALBEDO = n_out55p0;
	ALPHA = dot(n_out60p0, vec3(0.333333, 0.333333, 0.333333));
	METALLIC = n_out21p0;
	ROUGHNESS = n_out20p0;
	AO = n_out19p0;
	NORMALMAP = n_out26p0;
	NORMALMAP_DEPTH = dot(n_out27p0, vec3(0.333333, 0.333333, 0.333333));
	AO_LIGHT_AFFECT = n_out53p0;

}

